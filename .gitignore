# Ignore everything by default (profile repo carries only README)
*
.*

# Whitelist README and .gitignore
!README.md
!README.*
!.gitignore

# Whitelist drafts folder and markdown drafts
!drafts/
!drafts/*.md

# One explicitly authorized local participation probe; keep other experiments ignored.
!experiments/
!experiments/participation-1/
!experiments/participation-1/README.md
!experiments/participation-1/run.py
!experiments/participation-1/result.json
!experiments/participation-1/RESULTS.md
!experiments/participation-1/review.json

# Separate-process follow-up; no other experiment directories are included.
!experiments/participation-2/
!experiments/participation-2/run.py
!experiments/participation-2/README.md
!experiments/participation-2/result.json
!experiments/participation-2/RESULTS.md

# Concrete endorsement consumer demonstration.
!experiments/endorsement-1/
!experiments/endorsement-1/run.py
!experiments/endorsement-1/README.md
!experiments/endorsement-1/result.json
!experiments/endorsement-1/RESULTS.md
